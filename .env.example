# Copie este archivo a .env y cambie los valores. NUNCA suba .env al repositorio.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambie_esta_clave
ODOO_MASTER_PASSWORD=cambie_esta_clave_maestra

# Integracion con GNS3 (opcional: tambien puede usar los botones de simulacion)
# host.docker.internal apunta a la maquina donde corre GNS3.
GNS3_URL=http://host.docker.internal:3080
GNS3_PROJECT_ID=
GNS3_USER=
GNS3_PASSWORD=
