  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login administrador (authenticate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test(\"Sin error JSON-RPC\", () => pm.expect(pm.response.json().error).to.be.undefined);",
                  "pm.test(\"Devuelve uid numérico\", () => pm.expect(j.result).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"admin_uid\", j.result);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/jsonrpc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "jsonrpc"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"service\": \"common\",\n    \"method\": \"authenticate\",\n    \"args\": [\n      \"{{db}}\",\n      \"{{admin_login}}\",\n      \"{{admin_api_key}}\",\n      {}\n    ]\n  },\n  \"id\": 1\n}",
              "options": {
                "raw": {
