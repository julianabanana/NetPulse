<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_netpulse" model="ir.module.category">
        <field name="name">NetPulse</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_netpulse_technician" model="res.groups">
        <field name="name">Técnico</field>
        <field name="category_id" ref="module_category_netpulse"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_netpulse_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_netpulse"/>
        <field name="implied_ids" eval="[(4, ref('group_netpulse_technician'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- El técnico solo ve y edita las incidencias que tiene asignadas -->
    <record id="rule_incident_technician" model="ir.rule">
        <field name="name">NetPulse: el técnico ve solo sus incidencias</field>
        <field name="model_id" ref="model_netpulse_incident"/>
        <field name="domain_force">[('technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_netpulse_technician'))]"/>
    </record>

    <record id="rule_incident_admin" model="ir.rule">
        <field name="name">NetPulse: el administrador ve todas las incidencias</field>
        <field name="model_id" ref="model_netpulse_incident"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_netpulse_admin'))]"/>
    </record>
</odoo>
