<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="netpulse_user_wizard_view_form" model="ir.ui.view">
        <field name="name">netpulse.user.wizard.form</field>
        <field name="model">netpulse.user.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear usuario de NetPulse">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="login"/>
                        <field name="email"/>
                    </group>
                    <group>
                        <field name="role"/>
                        <field name="password" password="True"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_user" type="object"
                            string="Crear usuario" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_netpulse_create_user" model="ir.actions.act_window">
        <field name="name">Crear usuario</field>
        <field name="res_model">netpulse.user.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="netpulse_user_wizard_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
